   "scene": "street",
   "who": "narrator",
   "pre": 1.0,
   "text": "Zara left the notebook with the guard. With one new page."
  },
  {
   "scene": "notebook",
   "who": "narrator",
   "pre": 0.5,
   "text": "Hello. From the girl on the eleven forty. And her number."
  },
  {
   "scene": "closeup#a1",
   "who": "narrator",
   "pre": 0.5,
   "text": "The next morning, Adam read it three times."
  },
  {
   "scene": "closeup#a1",
   "who": "adam",
   "pre": 0.3,
   "text": "She saw it. She actually saw it."
  },
  {
   "scene": "notebook",
   "who": "narrator",
   "pre": 0.5,
   "text": "But the rain had soaked the page. The last two numbers were gone."
  },
  {
   "scene": "carriage",
   "who": "narrator",
   "pre": 0.5,
   "text": "So that night, Adam rode the eleven forty again.",
   "sfx": [
