 "lines":[
  {"scene":"stop","who":"narrator","pre":0.8,"text":"The bus doors hissed open by themselves.","sfx":["doors"]},
  {"scene":"stop","who":"narrator","pre":0.3,"text":"In the fog stood a line of people. Silent. Soaking wet."},
  {"scene":"stop","who":"narrator","pre":0.3,"text":"One by one, they climbed aboard. None of them paid."},
  {"scene":"stop","who":"marcus","pre":0.4,"text":"Where are you all going?"},
  {"scene":"stop","who":"woman","fx":"close","pre":0.6,"text":"Home. We've waited thirty years for this bus."},
  {"scene":"news","who":"narrator","pre":0.6,"text":"In nineteen ninety four, the last bus on Route thirteen crashed into Hollow Creek. Nobody survived."},
  {"scene":"dawn","who":"narrator","pre":0.6,"text":"When the sun came up, the bus was empty again."},
  {"scene":"ticket","who":"narrator","pre":0.5,"text":"Only a single ticket was left on the seat. For tomorrow night."},
  {"scene":"ticket","who":"narrator","pre":0.5,"text":"One passenger. Marcus Hale."},
