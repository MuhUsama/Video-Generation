 "lines": [
  {
   "scene": "platform",
   "who": "narrator",
   "pre": 1.0,
   "text": "Midnight. Platform four. Empty. Just the rain.",
   "sfx": [
    "thunder"
   ]
  },
  {
   "scene": "platform",
   "who": "narrator",
   "pre": 0.5,
   "text": "The lights flickered out. Zara turned to leave."
  },
  {
   "scene": "platform",
   "who": "adam",
   "pre": 0.8,
   "text": "You won't catch the last train. There isn't one tonight."
  },
  {
   "scene": "closeup#z",
   "who": "zara",
   "pre": 0.5,
   "text": "You walked here? In this?"
  },
  {
   "scene": "closeup#a",
   "who": "adam",
   "pre": 0.4,
   "text": "Six miles. I wasn't going to miss you again."
  },
  {
   "scene": "closeup#a",
   "who": "adam",
   "pre": 0.5,
   "text": "Hi. I'm Adam."
  },
  {
   "scene": "closeup#z2",
   "who": "zara",
   "pre": 0.5,
   "text": "I know. Hello, Adam."
  },
  {
   "scene": "sunrise",
   "who": "narrator",
   "pre": 0.8,
   "text": "Some people meet by accident. Some ride the same train for a year, waiting for the courage to say hello."
  },
