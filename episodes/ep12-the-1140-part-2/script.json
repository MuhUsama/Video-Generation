  {
   "scene": "platform",
   "who": "narrator",
   "pre": 1.0,
   "text": "The next night, Zara got to the platform early. His notebook in her hands."
  },
  {
   "scene": "carriage",
   "who": "narrator",
   "pre": 0.5,
   "text": "Eleven forty. The train came. His seat stayed empty.",
   "sfx": [
    "doors"
   ]
  },
  {
   "scene": "closeup#z1",
   "who": "zara",
   "pre": 0.5,
   "text": "Come on. You said tomorrow."
  },
  {
   "scene": "notebook",
   "who": "narrator",
   "pre": 0.5,
   "text": "Inside the cover, a name. Adam. Elm Street Tower. Night security."
  },
  {
   "scene": "street",
   "who": "narrator",
   "pre": 0.5,
   "text": "So she got off at Elm Street. In the rain."
  },
  {
   "scene": "closeup#g",
   "who": "guard",
   "pre": 0.4,
   "text": "Adam? He switched to the day shift. Starts tomorrow morning."
  },
  {
   "scene": "closeup#z2",
   "who": "narrator",
   "pre": 0.5,
   "text": "The day shift. He would never ride the eleven forty again."
  },
  {
   "scene": "closeup#z2",
   "who": "zara",
   "pre": 0.4,
   "text": "Then I'll leave him a hello of my own."
  },
