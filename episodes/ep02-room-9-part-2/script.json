 "lines":[
  {"scene":"behind","who":"narrator","pre":0.6,"text":"Last time, a voice whispered from right behind him.","sfx":["thunder"]},
  {"scene":"hall","who":"narrator","pre":0.6,"text":"Daniel spun around. The hallway was empty."},
  {"scene":"hall","who":"narrator","pre":0.4,"text":"Just a trail of wet, black footprints, leading into room nine."},
  {"scene":"room","who":"narrator","pre":0.6,"text":"Inside, everything was burnt. Everything, except one thing."},
  {"scene":"room","who":"narrator","pre":0.3,"text":"The guest book, lying open on the bed."},
  {"scene":"book","who":"narrator","pre":0.5,"text":"The last entry was written tonight. Room nine. Three oh seven A.M."},
  {"scene":"book","who":"narrator","pre":0.4,"text":"And the signature was his own."},
  {"scene":"book","who":"daniel","pre":0.4,"text":"That's my handwriting."},
  {"scene":"room_phone","who":"narrator","pre":0.9,"text":"Then the burnt phone on the wall began to ring.","sfx":["ring"]},
  {"scene":"room_phone","who":"daniel","pre":0.7,"text":"Hello?","sfx":["click"]},
  {"scene":"room_phone","who":"daniel","fx":"phone","pre":0.9,"text":"Please... don't send anyone up."},
  {"scene":"title","who":"none","pre":0.5,"text":""}
 ]}
